[
    {
        "id": 1,
        "priority": 1,
        "action": {
            "type": "modifyHeaders",
            "responseHeaders": [
                {
                    "header": "Access-Control-Expose-Headers",
                    "operation": "append",
                    "value": "Content-Length, Content-Range, Content-Type, Accept-Ranges"
                }
            ]
        },
        "condition": {
            "regexFilter": "^https?://",
            "resourceTypes": [
                "xmlhttprequest",
                "media",
                "other"
            ]
        }
    }
]
