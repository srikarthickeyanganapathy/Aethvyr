{
    "root": true,
    "env": {
        "browser": true,
        "es2022": true,
        "webextensions": true
    },
    "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "script"
    },
    "globals": {
        "browser": "readonly"
    },
    "extends": "eslint:recommended",
    "rules": {
        "no-empty": ["error", { "allowEmptyCatch": true }],
        "no-unused-vars": ["warn", { "args": "none" }]
    },
    "overrides": [
        {
            "files": ["background/**/*.js", "scripts/**/*.js"],
            "parserOptions": { "sourceType": "module" }
        },
        {
            "files": ["scripts/**/*.js"],
            "env": { "node": true, "browser": false }
        }
    ],
    "ignorePatterns": ["dist/", "node_modules/"]
}
