{
    "name": "aethvyr",
    "version": "2.10.0",
    "description": "Aethvyr plays HLS, DASH and MP4 video in an accessible player with adaptive buffering and a personal library.",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node scripts/build.js",
        "build:chrome": "node scripts/build.js --target=chrome",
        "build:firefox": "node scripts/build.js --target=firefox",
        "watch": "node scripts/build.js --watch",
        "lint": "eslint background common content player popup scripts",
        "test": "node --test",
        "package": "node scripts/package.js"
    },
    "keywords": [
        "browser-extension",
        "streaming",
        "video",
        "mobile",
        "firefox",
        "chrome"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "archiver": "^6.0.1",
        "eslint": "^8.56.0",
        "terser": "^5.26.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "shaka-player": "5.3.3"
    }
}
